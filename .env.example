# Copy to .env. Everything is optional in development.

PORT=3000

# Real Postgres (matches `docker compose up -d postgres`). Leave empty to use the embedded dev database.
DATABASE_URL=postgresql://proxify:proxify_password@localhost:5433/proxify_db
# Persist the embedded database between runs when DATABASE_URL is empty:
# PGLITE_DIR=.pglite-data

# Guards provisioning, funding, policy changes, org audit, webhooks and the dashboards.
# REQUIRED in production (>= 16 chars). Generate one:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_TOKEN=

# Signed-request clock skew allowed (ms). Nonces are kept for twice this.
# SIGNATURE_WINDOW_MS=120000
# Per-IP requests/minute on /v1 (0 disables)
# RATE_LIMIT_PER_MIN=600

# Webhooks
# WEBHOOKS_ENABLED=true
# WEBHOOK_POLL_MS=2000
# WEBHOOK_MAX_ATTEMPTS=8
# Development only: allow http:// webhook URLs
# ALLOW_INSECURE_WEBHOOKS=false

# Demo: run against an already-running server instead of booting one in-process
# PROXIFY_BASE_URL=http://localhost:3000
